{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["keywords"],
  "properties": {
    "keywords": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword", "category", "reason"],
        "properties": {
          "keyword": {"type": "string"},
          "category": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
